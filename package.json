{
  "name": "toon-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Code-driven 2D cartoon animation engine for a YouTube channel, built on Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "check": "tsx scripts/check.ts",
    "render": "node scripts/render.mjs",
    "sync-audio": "node scripts/sync-audio.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:visual": "tsx scripts/visual-test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "bake-textures": "tsx scripts/bake-textures.ts",
    "production": "tsx scripts/production.ts",
    "pilot:voice": "tsx scripts/pilot-voice.ts",
    "production:voice": "tsx scripts/pilot-voice.ts",
    "production:benchmark": "python3 scripts/production-benchmark.py"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.547",
    "@remotion/three": "4.0.547",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.547",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.170.0",
    "pixelmatch": "6.0.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
